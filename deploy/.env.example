# myviking 환경 변수 예시 — Portainer 스택의 Environment variables 또는
# docker compose --env-file 로 사용합니다.

# 바깥에 열 포트 (기본 8787)
VIKING_PORT=8787

# 서버가 외부에서 보이는 주소. 비우면 접속한 주소로 안내합니다.
# 역방향 프록시 뒤에서는 여기에 https://viking.example.com 처럼 적으세요.
VIKING_BASE_URL=

# 새 가입 허용 (기본 true). 운영 중 막으려면 false
VIKING_ALLOW_SIGNUP=true

# 첫 가입자가 관리자가 됩니다 (기본 true)
VIKING_FIRST_USER_ADMIN=true

# 관리자 고정 이메일 (쉼표 구분). 이 목록에 있으면 가입 즉시 관리자
VIKING_ADMIN_EMAILS=

# 세션 서명 시크릿 — 비우면 자동 생성되어 볼륨에 보관됩니다
VIKING_SECRET=

# ── 선택: LLM (한 줄 요약·개요 품질 향상, 없어도 동작) ──
# VIKING_LLM_BASE_URL=https://api.openai.com/v1
# VIKING_LLM_API_KEY=sk-...
# VIKING_LLM_MODEL=gpt-4o-mini

# ── 선택: 임베딩 (의미 검색, 없으면 키워드 검색) ──
# VIKING_EMBED_BASE_URL=https://api.openai.com/v1
# VIKING_EMBED_API_KEY=sk-...
# VIKING_EMBED_MODEL=text-embedding-3-small