# deploy/.env 로 복사해서 쓰세요. 전부 선택 사항입니다 — 비워 두면 그대로 동작합니다.
#   cp deploy/.env.example deploy/.env

# ── 포트 · 바인딩 (docker-compose.yml 이 이 값을 읽습니다) ──

# 대시보드·API 가 열리는 호스트 포트 번호입니다. 컨테이너 안 포트는 항상 8787.
MYVIKING_PORT=8787

# 바인딩할 호스트 주소입니다. 비우면 모든 인터페이스(0.0.0.0) — 사내 LAN/포트포워딩 기본.
#   127.0.0.1   이 머신에서만
#   100.64.0.5  특정 IP(Tailscale/VPN) 만
MYVIKING_BIND=

# 참고: `bash deploy/up.sh` 를 쓰면 up.sh 가 위 두 값을 모드에 맞게 다시 기록합니다.
# 직접 `docker compose up -d` 로 띄우는 경우가 여기를 고치는 경우입니다 — 바꾼 뒤
# `docker compose up -d` 만 다시 실행하면 반영됩니다.

# ── 품질 (서버를 띄운 뒤 넣고 `bash deploy/up.sh` 를 다시 실행하면 적용됩니다) ──
# 참고: 웹 대시보드 → '모델' 탭에서도 같은 설정을 할 수 있습니다 (저장되면
# 이 환경변수보다 우선합니다. 초기화는 대시보드의 '웹 설정 초기화').

# 요약·증류 품질을 올립니다 (없으면 규칙 기반으로 동작). 키만 넣으면 anthropic 이 켜집니다.
ANTHROPIC_API_KEY=
# 다른 LLM 을 쓸 때만: anthropic | openai | volcengine | ollama, 그리고 모델명.
JARVIS_LLM_PROVIDER=
JARVIS_LLM_MODEL=
# OpenAI 호환 엔드포인트를 그대로 쓸 때 (Databricks Serving, 회사 게이트웨이 등):
#   JARVIS_LLM_PROVIDER=openai
#   JARVIS_LLM_MODEL=<엔드포인트 모델명>
#   JARVIS_LLM_BASE_URL=https://.../serving-endpoints/.../invocations   (끝의 # 는 빼세요)
#   JARVIS_LLM_PATH=/        ← base_url 이 곧 엔드포인트(/invocations)면 이렇게 (기본은 /chat/completions)
#   OPENAI_API_KEY=<그 엔드포인트의 토큰>
JARVIS_LLM_BASE_URL=
JARVIS_LLM_PATH=
# reasoning 모델(deepseek 계열)은 사고 토큰이 따로 빠집니다. 요약이 사고만
# 가득 차서 잘리면 4096 등으로 올리세요 (기본 2048).
JARVIS_LLM_MAX_OUTPUT_TOKENS=

# 의미 기반 회상 — "릴리스 어떻게?" 가 "배포 명령" 을 찾게 합니다. 비우면 오프라인 해시 임베딩
# (키워드 일치에 가깝습니다). 바꾸면 다음 접근 때 스스로 다시 색인합니다. 둘 중 하나:
#   1) OpenAI:  JARVIS_EMBED_PROVIDER=openai  + OPENAI_API_KEY=sk-...   (모델 기본 text-embedding-3-small)
#   2) Ollama(무료·로컬, 한국어는 bge-m3 권장):  호스트에서 `ollama pull bge-m3` 후
#      JARVIS_EMBED_PROVIDER=ollama  JARVIS_EMBED_BASE_URL=http://host.docker.internal:11434/v1
JARVIS_EMBED_PROVIDER=
JARVIS_EMBED_MODEL=
JARVIS_EMBED_BASE_URL=
# 모델이 표에 없을 때만 벡터 차원을 직접 (text-embedding-3-small 1536, bge-m3 1024 는 자동).
JARVIS_EMBED_DIM=
OPENAI_API_KEY=
ARK_API_KEY=

# ── 노출 ──

# 외부 노출용 도메인 (DuckDNS 등 무료 DDNS 가능). up.sh --domain 이 채워 줍니다.
MYVIKING_DOMAIN=

# Caddy 뒤에 있을 때만 1. up.sh --domain 이 자동으로 켭니다.
MYVIKING_TRUST_PROXY=

# DuckDNS 를 쓸 때만: 토큰을 넣으면 up.sh --domain 이 IP 갱신 컨테이너를 함께 띄웁니다.
DUCKDNS_TOKEN=

# Cloudflare Tunnel 을 쓸 때만 (포트포워딩 없이 HTTPS): Zero Trust → Networks → Tunnels 의 토큰.
# Public hostname 은 HTTP · myviking:8787 로. CLOUDFLARE_DOMAIN 은 안내문에 쓰는 주소입니다.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_DOMAIN=
