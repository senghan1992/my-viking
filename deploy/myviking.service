# MyViking 상시 실행용 systemd 유닛
#
#   sudo cp deploy/myviking.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now myviking
#   journalctl -u myviking -f
#
# 먼저 (User/경로는 배포판에 맞게 — Ubuntu 는 ubuntu, Amazon Linux 는 ec2-user):
#   sudo mkdir -p /var/lib/myviking && sudo chown ec2-user /var/lib/myviking
#   JARVIS_HOME=/var/lib/myviking jv key create admin     ← 유닛과 *같은* JARVIS_HOME 이어야 합니다.
#      (기본 ~/.jarvis 에 키를 만들면 서비스는 /var/lib/myviking 을 보므로 인증 없이 열립니다)
# 그 다음 위 명령으로 유닛을 켜세요. TLS 는 Caddy 를 패키지로 설치해 deploy/Caddyfile 을 쓰면 됩니다.

[Unit]
Description=MyViking context server for coding agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Environment=JARVIS_HOME=/var/lib/myviking
# LLM 을 붙이려면 여기에 (증류·요약 품질만 올라갑니다)
# Environment=ANTHROPIC_API_KEY=...
WorkingDirectory=/opt/myviking
ExecStart=/opt/myviking/.venv/bin/jv serve --host 0.0.0.0 --port 8787
Restart=always
RestartSec=3

# 이 서비스가 건드려야 하는 것은 자기 데이터 디렉터리뿐입니다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myviking

[Install]
WantedBy=multi-user.target
