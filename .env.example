# 배포 설정 — cp .env.example .env 후 필요한 값만 고치세요 (docker compose 가 자동으로 읽음)
# Portainer 웹 편집기로 배포할 땐 이 값을 UI의 Environment variables 에 넣으세요.
# 기본값만으로도 전부 동작합니다. .env 자체가 없어도 됩니다.

# 바깥에 열 포트 (기본 8787)
SCRIBE_PORT=8787

# 공개 주소 — 역방향 프록시(HTTPS 도메인) 뒤에서: https://scribe.example.com
SCRIBE_BASE_URL=

# 가입/관리자
SCRIBE_ALLOW_SIGNUP=true
SCRIBE_FIRST_USER_ADMIN=true
SCRIBE_ADMIN_EMAILS=

# 세션 서명 + 에이전트 키 봉인 — 비우면 자동 생성되어 볼륨에 보관됩니다.
# 주의: 이 값을 바꾸면 이미 발급된 키의 평문을 다시 복사할 수 없습니다(인증은 해시라 그대로 동작,
# 연결 탭에서 '재발급'만 가능).
SCRIBE_SECRET=

# ── 선택: LLM/임베딩 (OpenAI 호환이면 DeepSeek·Groq·Ollama 등 모두 가능) ──
# 주의: 무엇을 지식으로 남길지 '판단'하는 건 서버 모델이 아니라 서기 agent(pi 세션)입니다.
# 여기 값은 지식의 한 줄 요약과 의미 검색 품질만 올려줍니다 — 비워도 전체가 동작합니다.
# base_url 을 비우면 OpenAI 가 기본. 안 채워도 동작하며,
# 배포 후에도 관리자 → 모델 설정 화면에서 키를 넣을 수 있습니다 (웹 설정이 env 보다 우선).
# 첫 실행 시드: 서버는 app/models_seed.json (pi 의 models.json = databricks 기준) 을
# 자동으로 기본 LLM/모델 카탈로그로 채웁니다. 끄려면 SCRIBE_SEED_MODELS=false
# 키는 저장소가 아닌 여기 환경변수로 넣습니다 — 시드가 이 값을 자동 적용합니다:
SCRIBE_LLM_API_KEY=
SCRIBE_LLM_BASE_URL=
SCRIBE_LLM_MODEL=gpt-4o-mini
SCRIBE_EMBED_BASE_URL=
SCRIBE_EMBED_API_KEY=
SCRIBE_EMBED_MODEL=text-embedding-3-small