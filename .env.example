# 배포 설정 — cp .env.example .env 후 필요한 값만 고치세요 (docker compose 가 자동으로 읽음)
# Portainer 웹 편집기로 배포할 땐 이 값을 UI의 Environment variables 에 넣으세요.
# 기본값만으로도 전부 동작합니다. .env 자체가 없어도 됩니다.

# 바깥에 열 포트 (기본 8787)
VIKING_PORT=8787

# 공개 주소 — 역방향 프록시(HTTPS 도메인) 뒤에서: https://viking.example.com
VIKING_BASE_URL=

# 가입/관리자
VIKING_ALLOW_SIGNUP=true
VIKING_FIRST_USER_ADMIN=true
VIKING_ADMIN_EMAILS=

# 세션 서명 — 비우면 자동 생성되어 볼륨에 보관됩니다
VIKING_SECRET=

# ── 선택: LLM/임베딩 (OpenAI 호환이면 DeepSeek·Groq·Ollama 등 모두 가능) ──
# base_url 을 비우면 OpenAI 가 기본. 안 채워도 동작하며,
# 배포 후에도 관리자 → 모델 설정 화면에서 키를 넣을 수 있습니다 (웹 설정이 env 보다 우선).
# 첫 실행 시드: 서버는 app/models_seed.json (pi 의 models.json = databricks 기준) 을
# 자동으로 기본 LLM/모델 카탈로그로 채웁니다. 끄려면 VIKING_SEED_MODELS=false
VIKING_LLM_BASE_URL=
VIKING_LLM_API_KEY=
VIKING_LLM_MODEL=gpt-4o-mini
VIKING_EMBED_BASE_URL=
VIKING_EMBED_API_KEY=
VIKING_EMBED_MODEL=text-embedding-3-small